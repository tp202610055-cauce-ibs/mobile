# Cauce Mobile · Environment Variables Template
# Copiar a .env y ajustar valores según el entorno local.
# NUNCA commitear el archivo .env (está en .gitignore).

# ─── Backend API base URLs por plataforma ───────────────────────────
# Android emulator (usa 10.0.2.2 para acceder al host)
API_BASE_URL_ANDROID=http://10.0.2.2:5074/api/v1

# iOS simulator (localhost accede directo al host)
API_BASE_URL_IOS=http://localhost:5074/api/v1

# ─── Keycloak OIDC issuer por plataforma ────────────────────────────
KEYCLOAK_ISSUER_ANDROID=http://10.0.2.2:8081/realms/cauce
KEYCLOAK_ISSUER_IOS=http://localhost:8081/realms/cauce

# ─── OIDC client config ─────────────────────────────────────────────
KEYCLOAK_CLIENT_ID=cauce-mobile
REDIRECT_SCHEME=cauce
REDIRECT_URI=cauce://login-callback

# ─── OIDC scopes ────────────────────────────────────────────────────
OIDC_SCOPES=openid,profile,email
