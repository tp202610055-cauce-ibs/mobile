# Cauce Mobile · Plantilla de variables de entorno
#
# Copiar a .env.dev, .env.staging o .env.prod segun el entorno y ajustar los
# valores. Esos tres archivos estan en .gitignore y nunca se commitean (R7).
# Este .env.example si se commitea, solo con placeholders.
#
# Nota sobre acta M9: el movil NO habla directo con Keycloak. La autenticacion
# va por backend passthrough (POST /api/v1/auth/login), asi que aqui no hay
# issuer, client secret ni redirect URI de OIDC.

# ─── Backend API ─────────────────────────────────────────────────────────
# Sin el sufijo /api/v1: el cliente generado ya incluye la ruta completa.
# Android emulator usa 10.0.2.2 para alcanzar el host; iOS simulator usa
# localhost. La app resuelve cual corresponde en runtime por platform check.
API_BASE_URL=http://10.0.2.2:5074

# ─── Identificacion del entorno ──────────────────────────────────────────
# Valores admitidos: dev | staging | prod
# Gobierna el logging de red: LogInterceptor solo se monta en dev.
ENV_NAME=dev

# ─── Cliente OAuth ante el backend ───────────────────────────────────────
# El backend exige este campo en el body de login, refresh y logout.
CLIENT_ID=cauce-mobile

# ─── Deep links ──────────────────────────────────────────────────────────
# Scheme registrado en AndroidManifest.xml y en Info.plist.
# El enlace de recuperacion de contrasena llega como
# cauce://auth/password-reset?token=xxx
DEEP_LINK_SCHEME=cauce
